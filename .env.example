# Local demo values only. Docker ports bind to localhost.
POSTGRES_PASSWORD=local-demo-db-password
SERVICE_TOKEN=local-demo-internal-token
DEMO_REVIEWER_TOKEN=local-demo-reviewer-token
DEMO_VIEWER_TOKEN=local-demo-viewer-token
LLM_MODE=mock
# Compatible mode expects a /v1/chat/completions endpoint with JSON output support.
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_MODEL=your-model-name
LLM_API_KEY=
# Configure actual provider rates to estimate successful extraction-call costs.
INPUT_USD_PER_MILLION=0
OUTPUT_USD_PER_MILLION=0
