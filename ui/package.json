{
  "name": "healthcare-assessment-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');const url=process.env.GATEWAY_URL||'';fs.writeFileSync('public/config.json',JSON.stringify({gatewayUrl:url},null,2));console.log('config.json → gatewayUrl:',url||'(empty, using proxy)')\"",
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {"@angular/common": "19.2.15", "@angular/compiler": "19.2.15", "@angular/core": "19.2.15", "@angular/forms": "19.2.15", "@angular/platform-browser": "19.2.15", "rxjs": "7.8.2", "tslib": "2.8.1", "zone.js": "0.15.1"},
  "devDependencies": {"@angular/build": "19.2.15", "@angular/cli": "19.2.15", "@angular/compiler-cli": "19.2.15", "typescript": "5.7.3"}
}
